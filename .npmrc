# pnpm config — see https://pnpm.io/npmrc
# T-007 (Phase 0): pin Node + tighten dep resolution

# Fail install if Node/pnpm version doesn't satisfy engines field in package.json
engine-strict=true

# Auto-install peerDependencies (pnpm 8+ default is false, which surprises users)
auto-install-peers=true

# Hoist commonly-needed-by-tooling packages so VS Code/ESLint/etc. find them
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*

# Keep pnpm lockfile in shrinkwrap mode for deterministic CI installs
shamefully-hoist=false

# Approval required before running install scripts of dependencies (pnpm 10+ default)
# Stays default. We approve esbuild/vue-demi when actually needed (see T-008/T-011).
