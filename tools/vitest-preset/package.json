{
  "name": "@ackplus/vitest-preset",
  "version": "2.8.2",
  "private": true,
  "type": "module",
  "description": "Shared Vitest config + real-test helpers (Testcontainers Postgres/Redis, OAuth stub server, email/SMS capture transports). Internal package, never published.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./helpers": "./helpers/index.js",
    "./helpers/postgres": "./helpers/postgres-container.js",
    "./helpers/redis": "./helpers/redis-container.js",
    "./helpers/oauth-stub": "./helpers/oauth-stub-server.js",
    "./helpers/email-capture": "./helpers/email-capture.transport.js",
    "./helpers/sms-capture": "./helpers/sms-capture.transport.js",
    "./helpers/boot-test-app": "./helpers/boot-test-app.js"
  },
  "files": [
    "index.js",
    "helpers/"
  ],
  "dependencies": {
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "@testcontainers/postgresql": "^11.0.0",
    "@testcontainers/redis": "^11.0.0",
    "testcontainers": "^11.0.0"
  }
}
